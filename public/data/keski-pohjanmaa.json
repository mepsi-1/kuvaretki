726,23.13989]]},{"id":220111,"sci":"Flavocetraria nivalis","fi":"Lapalumijäkälä","group":"Fungi","photo":"https://inaturalist-open-data.s3.amazonaws.com/photos/43545964/medium.jpeg","photoSmall":"https://inaturalist-open-data.s3.amazonaws.com/photos/43545964/square.jpeg","attribution":"(c) Tom Walker, some rights reserved (CC BY-NC), uploaded by Tom Walker","wiki":"https://fi.wikipedia.org/wiki/Lapalumijäkälä","summary":"<b>Lapalumijäkälä</b> (<i>Flavocetraria nivalis</i>) on lumijäkälien sukuun kuuluva vaaleankellertävä röyhelömäinen pensasjäkälä. Se on päältä verkkoryppyinen ja kouruinen. Ulkonäöltään se on läheinen etenkin kourulumijäkälän (<i>Flavocetraria cucullata</i>) kanssa. Lapalumijäkälä on yleinen muun muassa Pohjois-Skandinaviassa ja -Suomessa. Se kasvaa tiheinä mättäinä usein tunturikankailla. Etelä-Suomessa lapalumijäkälä on sen sijaan harvinainen. Lapalumijäkälän jäkäläaineena eli sekundaarisena aineenvaihduntatuotteena esiintyy usniinihappoa (C18H16O7) ja protolikesteriinihappoa (C19H32O4).","spread":24380,"m":[0,0,0,0,2,2,1,3,0,1,0,0],"s":[[63.54513,23.74565],[63.84548,23.80295],[64.09268,23.40061],[63.94953,22.84475],[64.09229,23.40136],[64.09268,23.40068],[64.09269,23.40057],[64.09284,23.40014]]},{"id":51660,"sci":"Psyllobora vigintiduopunctata","fi":"Ahopirkko","group":"Insecta","photo":"https://inaturalist-open-data.s3.amazonaws.com/photos/23521264/medium.jpg","photoSmall":"https://inaturalist-open-data.s3.amazonaws.com/photos/23521264/square.jpg","attribution":"(c) Janne Asp, some rights reserved (CC BY-NC), uploaded by Janne Asp","wiki":"https://fi.wikipedia.org/wiki/Ahopirkko","summary":"<b>Ahopirkko</b> (<i>Psyllobora vigintiduopunctata</i>), jota kutsutaan myös nimellä <b>22-pistepirkko</b>, on leppäkerttujen heimoon kuuluva hyönteislaji. Ahopirkko on 3-4 mm kokoinen kovakuoriainen, jonka kirkkaankeltaisissa peitinsiivissä on 22 pistettä. Ahopistepirkot liikkuvat pensaiden ja ruohovartisten kasvien lehdille. Sekä aikuiset että toukat ovat hyödyllisiä, sillä ne syövät kasveista härmän sienirihmastoja lehtien pinnoilta.","spread":24648,"m":[0,0,3,0,1,7,5,7,1,0,0,0],"s":[[63.62017,24.40204],[63.83821,23.0991],[63.82265,23.04375],[63.83859,23.09808],[64.05809,23.50606],[63.82434,23.11674],[63.83827,23.09925],[63.83772,23.0981]]},{"id":55971,"sci":"Tanacetum vulgare","fi":"Pietaryrtti","group":"Plantae","photo":"https://inaturalist-open-data.s3.amazonaws.com/photos/45581182/medium.jpg","photoSmall":"https://inaturalist-open-data.s3.amazonaws.com/photos/45581182/square.jpg","attribution":"(c) Robert D Stevenson, some rights reserved (CC BY-NC), uploaded by Robert D Stevenson","wiki":"https://fi.wikipedia.org/wiki/Pietaryrtti","summary":"<b>Pietaryrtti</b> (<i>Tanacetum vulgare</i> syn. <i>Chrysanthemum vulgare</i>; nappikukka) on asterikasveihin kuuluva keltakukkainen monivuotinen ruoho. Se kasvaa alkuperäisenä Euroopassa ja Aasiassa. Suomessa se on yleinen maan etelä- ja keskiosissa Oulun korkeudelle asti. Monin paikoin pietaryrttiä tavataan viljelyjäänteenä. Pohjois-Amerikkaan se on levinnyt viljelykasvien mukana rikkaruohona.","spread":24908,"m":[0,0,0,0,4,4,26,28,17,5,1,1],"s":[[63.91331,23.89986],[63.63275,23.49366],[63.8802,23.0743],[63.832,23.03179],[63.89133,23.10216],[63.86672,23.10332],[63.8667,23.10374],[63.82456,23.15253],[63.61729,24.40819],[63.94965,22.8423],[63.94836,22.84987],[63.83195,23.03096],[63.85068,23.14145],[63.85386,23.11075],[63.81732,22.97834],[63.86688,23.1042],[63.83778,23.03853],[64.08898,23.40404],[63.8674,23.15035],[63.62859,23.49694],[63.83033,23.09898],[64.08846,23.40987],[64.09175,23.40409],[64.08897,23.40404],[64.08934,23.41183],[63.85245,23.11652],[63.84871,23.11385],[63.84411,23.14991],[63.82468,23.20325],[63.85046,23.14299],[64.0889,23.41036],[63.4934,24.33212],[64.05771,23.47098],[63.83018,23.0843],[63.39756,24.03605],[63.85043,23.14243],[64.08878,23.41049]]}]}