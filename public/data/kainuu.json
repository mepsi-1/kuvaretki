i/Haavankeltajäkälä","summary":"<b>Haavankeltajäkälä</b> (<i>Xanthoria parietina</i>) on keltaoranssi jäkälä, jota kasvaa puiden rungoilla ja kivipinnoilla. Se muodostaa leveäliuskaisia, pyöreähköjä laikkuja, joiden pinnalle nousee kanelinruskeita kotelomaljoja.","spread":31324,"m":[0,1,2,3,5,1,4,1,2,0,1,0],"s":[[64.49714,28.22235],[64.40264,27.84198],[64.13409,28.39619],[64.39276,27.81087],[64.21514,27.68817],[64.16991,28.20678],[64.22073,27.73363],[64.05076,28.57969],[64.85068,28.9691],[64.22895,27.76665]]},{"id":339410,"sci":"Stereum rugosum","fi":"Ryppynahakka","group":"Fungi","photo":"https://inaturalist-open-data.s3.amazonaws.com/photos/332127152/medium.jpg","photoSmall":"https://inaturalist-open-data.s3.amazonaws.com/photos/332127152/square.jpg","attribution":"(c) Георгий Ботвинкин, some rights reserved (CC BY-NC), uploaded by Георгий Ботвинкин","wiki":null,"summary":"","spread":31495,"m":[0,0,0,2,3,0,1,0,2,2,0,0],"s":[[64.69864,27.33815],[64.70587,27.98416],[64.70616,27.31405],[64.17957,28.21147]]},{"id":54468,"sci":"Aglais urticae","fi":"Nokkosperhonen","group":"Insecta","photo":"https://inaturalist-open-data.s3.amazonaws.com/photos/257869609/medium.jpg","photoSmall":"https://inaturalist-open-data.s3.amazonaws.com/photos/257869609/square.jpg","attribution":"(c) simben, some rights reserved (CC BY-NC-ND), uploaded by simben","wiki":"https://fi.wikipedia.org/wiki/Nokkosperhonen","summary":"<b>Nokkosperhonen</b> (<i>Aglais urticae</i>) on täpläperhosten heimoon kuuluva, Euroopassa elävä päiväperhonen. Se on tavallisimpia päiväperhosia.","spread":32153,"m":[0,0,0,3,6,3,14,10,4,0,0,0],"s":[[64.40391,27.8103],[64.9363,28.42417],[64.39403,27.98388],[64.88415,28.90927],[64.27202,27.56576],[64.29443,27.85619],[63.91363,28.97039],[64.22734,27.7341],[64.40288,27.71673],[64.17934,28.19333],[64.22225,27.66772],[64.14205,28.25462],[64.19505,28.00491],[64.40387,27.8104],[64.05046,28.57845],[64.40381,27.81039],[64.16413,28.20425],[64.22961,27.72125],[64.25609,27.69907],[64