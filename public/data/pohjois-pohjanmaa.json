iki/Ukonkello","summary":"<b>Ukonkello</b> (<i>Campanula latifolia</i>) on monivuotinen kellokasvien heimoon kuuluva kasvilaji. Se kasvaa yleensä 50–130 cm korkeaksi ja sitä esiintyy lehdoissa, lehtoniityillä, puistoissa ja pihoilla. Ukonkello kukkii heinä-elokuussa ja sen kukat ovat vaaleanvioletteja. Kukinto on lehtevä terttu, joka sijaitsee kasvin kukkavarren päässä. Ukonkellon verhiönliuskat ovat kapeanpuikeita ja teriö 20–40 mm pitkä, mutta pituuttaan leveämpi. Ukonkellon lehdet ovat lehtilaidaltaan toistamiseen sahalaitaisia ja muodoltaan alimmat ovat herttamaisia tai puikeita ja ylimmät puikeita tai suikeita.","spread":68504,"m":[0,0,0,0,0,4,24,4,0,0,0,0],"s":[[65.02367,25.51201],[65.02337,25.51185],[63.96409,25.74811],[63.67498,25.96589]]},{"id":1289484,"sci":"Curruca curruca","fi":"Hernekerttu","group":"Aves","photo":"https://inaturalist-open-data.s3.amazonaws.com/photos/198608809/medium.jpg","photoSmall":"https://inaturalist-open-data.s3.amazonaws.com/photos/198608809/square.jpg","attribution":"(c) Евгений Гурьевских, some rights reserved (CC BY-NC), uploaded by Евгений Гурьевских","wiki":"https://fi.wikipedia.org/wiki/Hernekerttu","summary":"<b>Hernekerttu</b> (<i>Curruca curruca</i>) on pieni harmahtava kerttulaji, jolla on päässään naamiota muistuttava tumma kuvio.","spread":70791,"m":[0,0,0,0,21,12,4,6,2,0,0,0],"s":[[64.98844,25.30949],[65.0022,24.73888],[65.07674,25.45976],[64.93965,25.38703],[64.82567,25.30711],[64.28052,23.89586],[64.26207,23.84601],[64.8081,26.01222],[64.79677,25.88231],[64.71342,24.5226],[64.71342,24.52228],[64.87537,25.20265],[64.86062,25.35261],[64.94468,25.43615],[66.36872,29.31469],[64.94415,25.45036],[65.003,25.62747],[64.71307,24.51789],[64.32475,27.07313],[64.80158,24.96863]]}]}